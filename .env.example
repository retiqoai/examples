#
# Copy to .env and fill in. Never commit .env. Offline runs (--offline) need none of this.

# WebSocket URL of your RetiQo instance host
RETIQO_HOST_URL=ws://localhost:8080/ws

# Application ID from the RetiQo portal (Applications)
RETIQO_APP_ID=

# The host only accepts agents created in advance in the portal (status Pending, in the
# application above, deployed to this host). Put their IDs in .retiqo/devices.txt, one per
# line; provisioned credentials are saved to .retiqo/credentials.json. Override the locations if you need to:
# RETIQO_DEVICES_FILE=.retiqo/devices.txt
# RETIQO_CREDENTIALS_FILE=.retiqo/credentials.json

# Optional: contract IDs of each example's schema.scd uploaded in the portal.
# Without them, the schema text is sent when the execution is created.
# RETIQO_CONTRACT_ID_ENTERPRISE_MULTI_AGENT=
# RETIQO_CONTRACT_ID_SUPPLY_CHAIN_COORDINATION=
# RETIQO_CONTRACT_ID_AI_AGENT_MARKETPLACE=
# RETIQO_CONTRACT_ID_FEDERATED_LEARNING=
# RETIQO_CONTRACT_ID_TREASURY_APPROVALS=
# RETIQO_CONTRACT_ID_OPTIONS_HEDGING=
# RETIQO_CONTRACT_ID_PERFORMANCE_TEST=
